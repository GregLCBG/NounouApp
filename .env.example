# Modèle des variables d'environnement : ne JAMAIS y mettre de vraies valeurs (ce fichier est sur GitHub).
# Les vraies valeurs vivent dans Vercel (Project → Settings → Environment Variables)
# et, pour le dev local, dans .env.local (ignoré par git).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Agenda → Paramètres de l'agenda → "Adresse secrète au format iCal" (contient "private-")
GOOGLE_AGENDA_ICAL_URL=
